{
  "name": "jisr",
  "version": "1.0.0",
  "description": "Jisr (جِسر) - Privacy-first AI writing companion & support drafting for Libyan youth",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "mobile": "expo start",
    "mobile:android": "expo start --android",
    "mobile:web": "expo start --web",
    "test": "npm run test:safety && npm run test:app",
    "test:safety": "node safety/selftest.mjs && node safety/evaluate.mjs safety/dev-set.json",
    "test:app": "node tests/verify-trust-components.mjs && node tests/verify-crisis-parity.mjs && node tests/test-pii-sanitizer.mjs && node tests/test-api-client.mjs && node tests/test-private-record.mjs && node tests/test-offline-fallback.mjs && node tests/verify-m2-integration.mjs && node tests/verify-honest-ui.mjs",
    "test:trust": "node tests/verify-trust-components.mjs",
    "test:parity": "node tests/verify-crisis-parity.mjs",
    "test:backend": "cd backend && python -m pytest -q",
    "test:all": "npm test && npm run test:backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codathon-G3/Jisr.git"
  },
  "keywords": [
    "ai4ly",
    "codathon",
    "mental-health",
    "libya",
    "support-drafting"
  ],
  "author": "Mohamed Thabet, Rayan, Muatz, Shima",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Codathon-G3/Jisr/issues"
  },
  "homepage": "https://github.com/Codathon-G3/Jisr#readme",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo-google-fonts/readex-pro": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.27",
    "expo-font": "~57.0.4",
    "expo-status-bar": "^57.0.1",
    "next": "^16.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
